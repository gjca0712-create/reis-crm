{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // Esta pasta é compartilhada com outros projetos que NÃO fazem parte do CRM
  // da Reis (cada um com seu próprio package.json/tsconfig) — sem isso, o
  // `next build` tenta type-checar o código deles também e quebra.
  "exclude": [
    "node_modules",
    "regua",
    "aurum-cell",
    "conferencia-folha",
    "scratch-logo",
    "reis-source-para-crm",
    "entrada-de-nota",
    "shopping10"
  ]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Role/Profissao são strings simples em vez de enum nativo do Postgres — mantém
// os mesmos nomes de coluna/valor de quando o banco era SQLite (sem enum), e os
// conjuntos de valores válidos continuam vivendo em lib/constants.ts (Role, Profissao).

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  // null = usa a lista padrão do perfil (role); array = lista definitiva e
  // personalizada de features que esse usuário específico pode acessar.
  featureOverrides Json?
  createdAt    DateTime @default(now())

  sentMessages          Message[]
  resolvedConversations Conversation[] @relation("ResolvedConversations")
  assignedConversations Conversation[] @relation("AssignedConversations")
  ratings               Rating[]
  occurrencesReported   Occurrence[]
}

// Sem relation pro User de propósito — guarda ator/alvo como texto solto, não
// FK. Assim o registro sobrevive mesmo que o usuário envolvido seja removido
// no futuro (não existe exclusão de usuário hoje, mas não deve depender disso).
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String?
  actorName   String
  actorEmail  String?
  action      String
  targetId    String?
  targetLabel String?
  details     Json?

  @@index([createdAt])
}

// Parceiro indicador: pedreiro, eletricista, etc. Recebe o cashback das compras que indicou.
model Partner {
  id              String   @id @default(cuid())
  name            String
  phone           String
  profissao       String
  pixKey          String?
  notes           String?
  cashbackBalance Float    @default(0)
  createdAt       DateTime @default(now())

  customers  Customer[]
  sales      Sale[]
  cashbackTx CashbackTransaction[]
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  document      String?
  address       String?
  bairro        String
  city          String   @default("")
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  birthday      DateTime?
  // Fase da obra do cliente: INICIO, MEIO ou FIM — sinaliza que tipo de
  // material ele tende a precisar comprar em seguida.
  faseObra      String?

  // Identificador alternativo (@lid) que o WhatsApp usa pra esse contato em vez
  // do número de telefone, em parte da migração deles pra endereçamento por
  // privacidade — ver comentário em lib/whatsapp/client.ts. Guardado assim que
  // uma mensagem RECEBIDA revela o par lid<->telefone, pra permitir reconhecer
  // uma resposta mandada depois direto do celular pareado (nesse caso o
  // WhatsApp só entrega o @lid do cliente, não o telefone).
  whatsappLid String?

  referredById String?
  referredBy   Partner? @relation(fields: [referredById], references: [id])

  sales         Sale[]
  loyaltyTx     LoyaltyTransaction[]
  conversations Conversation[]
  ratings       Rating[]
  occurrences   Occurrence[]
  leadsConverted Lead[]
}

model Sale {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  partnerId      String?
  partner        Partner? @relation(fields: [partnerId], references: [id])
  total          Float
  notes          String?
  pointsEarned   Int
  cashbackAmount Float
  // Rastreamento da entrega: SEPARACAO -> EM_ROTA -> ENTREGUE (lib/constants.ts DeliveryStatus).
  deliveryStatus String   @default("SEPARACAO")
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  items       SaleItem[]
  occurrences Occurrence[]
}

// Itens de uma venda — o que de fato foi comprado (produto, quantidade, preço).
model SaleItem {
  id          String @id @default(cuid())
  saleId      String
  sale        Sale   @relation(fields: [saleId], references: [id])
  productName String
  quantity    Float  @default(1)
  unitPrice   Float
  subtotal    Float
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  points     Int
  type       String
  reference  String?
  createdAt  DateTime @default(now())
}

model CashbackTransaction {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  amount    Float
  type      String
  saleId    String?
  createdAt DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  status        String   @default("OPEN")
  // Qual das linhas de WhatsApp da loja (lib/whatsapp/lines.ts) recebeu e atende
  // essa conversa. A resposta do atendente sai sempre por essa mesma linha.
  line          String   @default("linha-1")
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // Preenchido quando um atendente marca a conversa como resolvida — é esse
  // atendente que fica creditado pela avaliação pedida em seguida.
  resolvedById    String?
  resolvedBy      User?    @relation("ResolvedConversations", fields: [resolvedById], references: [id])
  ratingRequested Boolean  @default(false)

  // Atendente que "assumiu" essa conversa (fila de atendimento). Enquanto
  // atribuída, some da lista de quem não é CEO/Gerente nem o próprio dono —
  // ver o filtro em whatsapp/suporte/page.tsx. null = livre, qualquer um pode
  // assumir.
  assignedToId String?
  assignedTo   User?   @relation("AssignedConversations", fields: [assignedToId], references: [id])

  messages Message[]
  rating   Rating?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String
  body           String
  createdAt      DateTime     @default(now())

  // Anexo (foto, documento, áudio) guardado no volume — ver lib/whatsapp/media.ts.
  // mediaUrl é só o nome do arquivo em disco; a URL servida é /api/whatsapp/media/<mediaUrl>.
  mediaUrl      String?
  mediaType     String? // "image" | "video" | "audio" | "document"
  mediaMimeType String?
  mediaFileName String?

  // Quem enviou (só se aplica a mensagens OUT enviadas por um atendente logado).
  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id])

  // Onde a mensagem está no WhatsApp: key.id + a conversa (remoteJid). É o que
  // precisa pra apagar pra todos/editar depois, e pra reconhecer quando o
  // cliente (ou o celular pareado) apaga/edita. null = mensagem de antes disso
  // existir, ou que não chegou a sair.
  waMessageId        String?
  waRemoteJid        String?
  // Áudio com legenda sai como DUAS mensagens no WhatsApp (áudio não aceita
  // legenda — ver sendWhatsAppMedia em lib/whatsapp/client.ts): esta é a do texto.
  waCaptionMessageId String?
  // Quando saiu no WhatsApp, pras que chegam por ele (cliente / celular pareado).
  // Difere de createdAt (hora em que o CRM gravou) quando chega atrasada — e é
  // daqui que contam os prazos de editar/apagar do WhatsApp. createdAt continua
  // sendo a ordem da conversa (e o "sem resposta" da lista).
  waSentAt           DateTime?

  editedAt      DateTime?
  originalBody  String? // texto antes da primeira edição (histórico interno)
  // Apagada pra todos — por nós (CRM ou celular) ou pelo cliente. O conteúdo
  // continua guardado aqui pro histórico interno; a tela mostra como apagada.
  deletedAt     DateTime?
  deletedByName String? // atendente que apagou pelo CRM (null = celular/cliente)

  @@index([waMessageId])
  @@index([waCaptionMessageId])
}

// Cópia exata (protobuf) de cada mensagem que o CRM mandou pelo WhatsApp, pelo
// id dela lá. Quando o celular de quem recebeu não consegue abrir a mensagem,
// ele pede reenvio — e o Baileys precisa do conteúdo original pra reenviar
// (getMessage em lib/whatsapp/client.ts). Só em memória, a cópia sumia a cada
// deploy/restart e a mensagem ficava em "Aguardando mensagem" pra sempre.
// Guardada por 14 dias.
model WaSentPayload {
  id        String   @id // key.id da mensagem no WhatsApp
  line      String
  payload   Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Avaliação do atendimento, coletada do cliente após a conversa ser resolvida.
model Rating {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  agentId        String?
  agent          User?        @relation(fields: [agentId], references: [id])
  score          Int
  createdAt      DateTime     @default(now())
}

model Campaign {
  id           String    @id @default(cuid())
  name         String
  message      String
  segment      String
  status       String    @default("RASCUNHO")
  audienceSize Int       @default(0)
  // Quantas mensagens já foram efetivamente entregues, atualizado durante o
  // disparo (status "ENVIANDO") — permite mostrar progresso em campanhas
  // grandes, já que o envio é sequencial e espaçado (ver actions.ts).
  sentCount    Int       @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

// Erro operacional registrado pela equipe (estoque, separação, entrega,
// devolução, etc.) — pedido do CEO para acompanhar quantidade e tipo por mês.
model Occurrence {
  id           String    @id @default(cuid())
  type         String
  description  String?
  saleId       String?
  sale         Sale?     @relation(fields: [saleId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  reportedById String?
  reportedBy   User?     @relation(fields: [reportedById], references: [id])
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Espelho do ERP da loja (Órbita/AlphaERP, banco MySQL `orbitadb` no computador
// da loja). SÓ LEITURA do lado do ERP: quem preenche essas tabelas é o programa
// de sincronização que roda na loja e manda os dados pra app/api/erp/sync — ou,
// antes da ligação existir, o gerador de demonstração (lib/erp/demo.ts), com
// `demo = true` em cada linha. A primeira sincronização real apaga a demo.
//
// Separado de propósito de Sale/Customer (fidelidade, cashback): essas telas
// (Financeiro, Produtos) leem só daqui, então nada disso mexe em ponto,
// cashback ou histórico de cliente do CRM. Dinheiro em Decimal (não Float).
// Cada model diz de qual tabela/coluna do Órbita o valor vem.
// ---------------------------------------------------------------------------

// produto + estoque.Saldo + último customedio.
model ErpProduct {
  id            String   @id @default(cuid())
  codigo        Int      @unique // produto.Codigo (NÃO idproduto)
  descricao     String
  grupo         String? // grupo.Descricao
  marca         String? // marca.Descricao
  unidade       String   @default("UN")
  precoVarejo   Decimal  @default(0) @db.Decimal(14, 2)
  // Último customedio.Valor — produto.UltimoCusto é vazio na maioria dos produtos.
  custo         Decimal? @db.Decimal(14, 4)
  // SUM(estoque.Saldo) — produto.Estoque é campo morto (sempre 0).
  estoque       Decimal  @default(0) @db.Decimal(14, 3)
  estoqueMinimo Decimal? @db.Decimal(14, 3)
  ativo         Boolean  @default(true)
  // Data de cadastro no ERP, se houver — produto novo não conta como "parado".
  cadastradoEm  DateTime?
  demo          Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

// saidanota — só venda válida (autorizada, não cancelada, não orçamento/DAV).
model ErpSale {
  id            String   @id @default(cuid())
  erpId         Int      @unique // saidanota.idsaidanota
  data          DateTime // DataEmissao, convertida do horário da loja pra UTC
  total         Decimal  @db.Decimal(14, 2) // vNF — o que o cliente pagou
  bruto         Decimal  @db.Decimal(14, 2) // vProd
  desconto      Decimal  @default(0) @db.Decimal(14, 2) // vDesc
  frete         Decimal  @default(0) @db.Decimal(14, 2) // vFrete
  modelo        String? // "65" NFC-e, "55" NF-e
  vendedor      String? // NomeVendedor (ou usuário do caixa)
  clienteCodigo Int? // CodigoCliente; null = consumidor final
  clienteNome   String?
  // Cancelada depois de importada: continua aqui (pra sincronização saber),
  // mas fica fora de todo total.
  cancelada     Boolean  @default(false)
  demo          Boolean  @default(false)

  items    ErpSaleItem[]
  payments ErpSalePayment[]

  @@index([data])
}

// saidaitem.
model ErpSaleItem {
  id            String   @id @default(cuid())
  saleId        String
  sale          ErpSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  produtoCodigo Int // saidaitem.Codigo = produto.Codigo
  descricao     String
  quantidade    Decimal  @db.Decimal(14, 4)
  valorTotal    Decimal  @db.Decimal(14, 2) // líquido de desconto (rateado incluso)
  // Custo unitário na DATA da venda (customedio vigente), congelado — o
  // saidaitem do Órbita não guarda custo. null = produto sem custo cadastrado
  // (fica fora do cálculo de margem, em vez de aparecer com 100%).
  custoUnitario Decimal? @db.Decimal(14, 4)

  @@index([saleId])
  @@index([produtoCodigo])
}

// pagamentovenda + tipodocumento.Descricao.
model ErpSalePayment {
  id     String  @id @default(cuid())
  saleId String
  sale   ErpSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  forma  String // "PIX", "Dinheiro", "Cartão de crédito", "Crediário"...
  valor  Decimal @db.Decimal(14, 2)

  @@index([saleId])
}

// recebimento — contas a receber (crediário, boleto, cheque).
model ErpReceivable {
  id              String    @id @default(cuid())
  erpId           Int       @unique // recebimento.idrecebimento
  clienteCodigo   Int?
  clienteNome     String
  clienteTelefone String? // contato.Celular — pra cobrar pelo WhatsApp
  documento       String? // tipodocumento.Descricao
  vencimento      DateTime
  valor           Decimal   @db.Decimal(14, 2) // ValorDocumento
  valorPago       Decimal   @default(0) @db.Decimal(14, 2)
  pagoEm          DateTime? // DataPagamento; null = em aberto
  // Cancelado OU Excluido no Órbita (lá é marcação, a linha não some). Fica
  // aqui fora de todo total — senão parcela de venda cancelada viraria "dívida".
  cancelado       Boolean   @default(false)
  demo            Boolean   @default(false)

  @@index([vencimento])
}

// pagamento — contas a pagar.
model ErpPayable {
  id         String    @id @default(cuid())
  erpId      Int       @unique // pagamento.idpagamento
  fornecedor String
  categoria  String? // plano de contas (pc3 -> pc2 -> pc1)
  vencimento DateTime
  valor      Decimal   @db.Decimal(14, 2)
  valorPago  Decimal   @default(0) @db.Decimal(14, 2)
  pagoEm     DateTime?
  cancelado  Boolean   @default(false) // Cancelado OU Excluido no Órbita
  demo       Boolean   @default(false)

  @@index([vencimento])
}

// Uma linha só ("erp"): quando chegou a última sincronização real, pra tela
// mostrar "atualizado há X min" e dar pra perceber se o programa da loja parou.
// A linha existir = o ERP de verdade já começou a mandar dados (a partir daí a
// demonstração não pode mais ser carregada).
model ErpSyncState {
  id         String    @id @default("erp")
  lastSyncAt DateTime?
  lastBatch  Json?
}

// Pedido de orçamento capturado no site (fora deste projeto) — vem via API
// pública (app/api/site/leads) e some daqui quando vira Customer de verdade.
model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  message     String?
  status      String   @default("NOVO")

  convertedCustomerId String?
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id])

  createdAt DateTime @default(now())
}

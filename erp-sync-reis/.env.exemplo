# Copie este arquivo para ".env" (na mesma pasta) e preencha.

# MySQL do Órbita NESTE computador. Usuário SÓ DE LEITURA (criar-usuario-leitura.sql).
# Nunca aponte para um IP de fora nem abra a porta 3306 na internet.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USUARIO=crm_leitura
MYSQL_SENHA=
MYSQL_BANCO=orbitadb

# Endereço do CRM e a chave do Railway (Variables > ERP_SYNC_KEY, a mesma aqui e lá).
CRM_URL=https://reis-crm-production-cf70.up.railway.app
ERP_SYNC_KEY=

# Opcionais
# Fuso da loja (Bahia: -03:00, sem horário de verão).
FUSO=-03:00
# Quantos dias de vendas o CRM guarda (o primeiro envio manda isso tudo).
DIAS_HISTORICO=365
# Mais de uma empresa no mesmo banco: número da empresa da Reis. Vazio = todas.
ID_EMPRESA=
